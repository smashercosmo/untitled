{
  "name": "movies",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev": "pnpm --filter @movies/sync dev",
    "seed": "pnpm --filter @movies/scripts seed",
    "fixtures:refresh": "pnpm --filter @movies/scripts fixtures:refresh",
    "web": "pnpm --filter @movies/web dev"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2"
}
